{
  "model": "opus[1m]",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "NotebookEdit(*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "revealjs-skill": {
      "source": {
        "source": "github",
        "repo": "ryanbbrown/revealjs-skill"
      }
    }
  }
}
