{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "NotebookEdit(*)",
      "Bash('/home/tim/.local/share/fnm/node-versions/v20.18.1/installation/lib/node_modules/@llmtrim/cli/node_modules/@llmtrim/linux-x64/bin/llmtrim' window-sub slash *)"
